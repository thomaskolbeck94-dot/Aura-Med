# AuraMed Open Source Environment Variables

# API Key Validation (SaaS)
# Set to 'false' for local usage or self-hosting without key validation
REQUIRE_API_KEY=false

# Home Assistant Push URL (Optional)
# N8N_WEBHOOK_URL=http://your-n8n-instance/webhook/auramed

# Google Cloud Vision API Credentials (Optional - for OCR Fallback)
# GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json
